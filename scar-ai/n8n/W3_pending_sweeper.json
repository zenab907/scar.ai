            {
              "id": "613adba5-50ae-4e7b-882e-afc4f3c2e4df",
              "name": "telegram_chat_id",
              "value": "CHANGE_ME_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ba894713-6da0-5e5d-a38a-09d9e707f7ca",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.backend_url }}/events/requeue-stuck",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.backend_key }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { older_than_seconds: 300 } }}"
      },
      "id": "e90e1eb6-aaae-5336-85f3-c3b6f2d85740",
      "name": "Requeue stuck events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ],
      "onError": "continueRegularOutput",
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.backend_url }}/events?status=pending&limit=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.backend_key }}"
            }
          ]
        },
        "options": {}
      },
      "id": "80d9fc19-9f9f-52df-8906-bfa99e80568e",
      "name": "Get pending events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ],
      "onError": "continueRegularOutput",
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.analysis_webhook_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.backend_key }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { event_id: $json.event_id } }}"
      },
      "id": "167db190-79c1-5dec-a4fe-8c91db7d8f4f",
      "name": "Trigger analysis (W2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
