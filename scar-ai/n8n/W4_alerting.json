        520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One alert per (mission, source device, category) per cooldown window: the AI service decides (atomic).\nconst a = $('Webhook').first().json.body;\nconst icon = { critical: '[CRITICAL]', high: '[HIGH]', medium: '[MEDIUM]', low: '[LOW]' }[a.severity] || '[ALERT]';\n// plain text on purpose: SSIDs are attacker-controlled, never render them as HTML/Markdown\nconst text = [\n  `SCAR ALERT ${icon} score ${a.risk_score}/100`,\n  `Category: ${a.category}`,\n  a.bssid ? `AP: ${a.ssid || '(hidden)'} / ${a.bssid}` : null,\n  a.mission_id ? `Mission: ${a.mission_id}` : null,\n  `Why: ${a.explanation}`,\n  `Action: ${a.recommended_action}`,\n  `Event: ${a.event_id}`\n].filter(Boolean).join('\\n').slice(0, 3500);\nconst key = [a.mission_id || '-', a.bssid || a.event_id, a.category].join('|');\nreturn [{ json: { text, alert: a, dedupe_key: key } }];"
      },
      "id": "37e753d8-bd34-55d1-aa21-03783406d7a9",
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ai_url }}/dedupe",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
