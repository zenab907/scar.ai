            },
            {
              "id": "f8bf36d3-a516-47b4-9458-c58e6d9b2a77",
              "name": "ai_url",
              "value": "http://ai-service:8001",
              "type": "string"
            },
            {
              "id": "5738a091-148b-4e24-a683-bd91adbe6606",
              "name": "ai_key",
              "value": "CHANGE_ME_AI_KEY",
              "type": "string"
            },
            {
              "id": "69338f7e-2238-451a-b596-b18e28587920",
              "name": "analysis_webhook_url",
              "value": "http://n8n:5678/webhook/scar/analyze",
              "type": "string"
            },
            {
              "id": "0b659078-1606-4a4a-a1dd-fe4852f1d3db",
              "name": "alert_webhook_url",
              "value": "http://n8n:5678/webhook/scar/alert",
              "type": "string"
            },
            {
              "id": "564fce58-57f8-4e6a-8037-4e7dba6bef52",
